{
  "name": "atml",
  "displayName": "ATML",
  "description": "Language support for ATML (Animation Text Markup Language) — syntax highlighting, snippets, build, preview, hover docs and completions.",
  "version": "1.3.0",
  "publisher": "atml-lang",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kajano-source/ATML.git"
  },
  "icon": "./icons/atml-icon-128.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:atml",
    "onDebug"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "atml",
        "aliases": [
          "ATML",
          "AnimationTextMarkupLanguage"
        ],
        "extensions": [
          ".atml"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/atml.svg",
          "dark": "./icons/atml.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "atml",
        "scopeName": "text.html.atml",
        "path": "./syntaxes/atml.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.atml": "html"
        }
      }
    ],
    "snippets": [
      {
        "language": "atml",
        "path": "./snippets/atml.json"
      }
    ],
    "commands": [
      {
        "command": "atml.build",
        "title": "ATML: Build to HTML"
      },
      {
        "command": "atml.preview",
        "title": "ATML: Preview Animation"
      },
      {
        "command": "atml.publish",
        "title": "ATML: Publish Site to dist/"
      },
      {
        "command": "atml.run",
        "title": "ATML: Run in Browser"
      }
    ],
    "keybindings": [
      {
        "command": "atml.build",
        "key": "ctrl+shift+b",
        "when": "editorLangId == atml"
      }
    ],
    "debuggers": [
      {
        "type": "atml",
        "label": "ATML",
        "languages": [
          "atml"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "file"
            ],
            "properties": {
              "file": {
                "type": "string",
                "description": "The .atml file to run (default: the open file).",
                "default": "${file}"
              },
              "fps": {
                "type": "number",
                "description": "Override frames-per-second for this run.",
                "default": 60
              },
              "noBrowser": {
                "type": "boolean",
                "description": "Compile + stage only, do not launch a browser.",
                "default": false
              }
            }
          }
        },
        "configurationSnippets": [
          {
            "label": "ATML: Run file in browser",
            "description": "Compile the .atml file and open it in your default browser.",
            "body": {
              "type": "atml",
              "request": "launch",
              "name": "Run ATML file",
              "file": "^\"\\${file}\""
            }
          }
        ],
        "initialConfigurations": [
          {
            "type": "atml",
            "request": "launch",
            "name": "Run ATML file",
            "file": "${file}"
          }
        ]
      }
    ],
    "configuration": {
      "title": "ATML",
      "properties": {
        "atml.defaultFps": {
          "type": "number",
          "default": 12,
          "minimum": 1,
          "maximum": 120,
          "description": "Default frames-per-second assumed for ATML preview/status bar when no fps attribute is found."
        },
        "atml.autoBuildOnSave": {
          "type": "boolean",
          "default": false,
          "description": "Automatically run ATML: Build to HTML when an .atml file is saved."
        },
        "atml.compilerPath": {
          "type": "string",
          "default": "",
          "description": "Path to the `atml` compiler binary or atmlc.py script. Leave empty to auto-detect (bundled compiler, PATH `atml`, or ../compiler/atmlc.py)."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@vscode/debugadapter": "^1.68.0",
    "@vscode/debugprotocol": "^1.68.0"
  }
}
