# Maintainer: ATML contributors <atml@example.com>
pkgname=atml
pkgver=1.4.1
pkgrel=1
pkgdesc="Animation & Transition Markup Language — .atml to .html compiler, runtime and editor support"
arch=('any')
url="https://github.com/kajano-source/ATML"
license=('MIT')
depends=('python')
optdepends=('tk: GUI installer'
            'code: VS Code integration (or cursor for Cursor)')
source=("https://github.com/kajano-source/ATML/releases/download/v$pkgver/atml-$pkgver-linux.tar.gz")
sha256sums=('REPLACE_WITH_RELEASE_TARBALL_SHA256')

package() {
  local src="$srcdir/atml-linux"
  install -dm755 "$pkgdir/usr/bin" "$pkgdir/usr/share/atml" \
    "$pkgdir/usr/share/applications" "$pkgdir/usr/share/mime/packages"

  for d in compiler runtime examples; do
    if [ -d "$src/$d" ]; then
      cp -r "$src/$d" "$pkgdir/usr/share/atml/$d"
    fi
  done

  # `atml` shim on PATH.
  cat > "$pkgdir/usr/bin/atml" <<'EOF'
#!/usr/bin/env bash
if [ -f /usr/share/atml/compiler/atmlc.py ]; then
  exec python3 /usr/share/atml/compiler/atmlc.py "$@"
else
  echo "ATML (/usr/share/atml)" >&2
  ls /usr/share/atml >&2
fi
EOF
  chmod 755 "$pkgdir/usr/bin/atml"

  # Desktop file + MIME registration.
  cat > "$pkgdir/usr/share/applications/atml.desktop" <<'EOF'
[Desktop Entry]
Type=Application
Name=ATML
Comment=ATML template compiler
Exec=/usr/bin/atml %f
Icon=text-html
MimeType=text/html-atml;
Categories=Development;TextEditor;
Terminal=true
EOF
  cat > "$pkgdir/usr/share/mime/packages/atml.xml" <<'EOF'
<?xml version="1.0" encoding="UTF-8"?>
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="text/html-atml">
    <comment>ATML template</comment>
    <glob pattern="*.atml"/>
  </mime-type>
</mime-info>
EOF
}
